<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14161C"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Bar atas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/starting"
            android:textColor="#C9D1E3"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/chkHaptic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/haptic"
            android:textColor="#C9D1E3"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDiscoverable"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discoverable" />

        <Button
            android:id="@+id/btnConnect"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pick_pc" />

        <Button
            android:id="@+id/btnDisconnect"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disconnect" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Kiri: L2/L1 + D-pad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnL2"
                    style="@style/PadShoulder"
                    android:text="L2" />

                <TextView
                    android:id="@+id/btnL1"
                    style="@style/PadShoulder"
                    android:text="L1" />
            </LinearLayout>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3"
                android:rowCount="3">

                <TextView
                    android:id="@+id/dpUp"
                    style="@style/PadRound"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:text="▲" />

                <TextView
                    android:id="@+id/dpLeft"
                    style="@style/PadRound"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:text="◀" />

                <TextView
                    android:id="@+id/dpRight"
                    style="@style/PadRound"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:text="▶" />

                <TextView
                    android:id="@+id/dpDown"
                    style="@style/PadRound"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:text="▼" />
            </GridLayout>
        </LinearLayout>

        <!-- Tengah: Select, PS, Start + dua analog stick -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSelect"
                    style="@style/PadSmall"
                    android:text="SELECT" />

                <TextView
                    android:id="@+id/btnPs"
                    style="@style/PadRound"
                    android:text="PS"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnStart"
                    style="@style/PadSmall"
                    android:text="START" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.example.psgamepad.AnalogStickView
                        android:id="@+id/stickLeft"
                        android:layout_width="116dp"
                        android:layout_height="116dp" />

                    <TextView
                        android:id="@+id/btnL3"
                        style="@style/PadSmall"
                        android:text="L3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.example.psgamepad.AnalogStickView
                        android:id="@+id/stickRight"
                        android:layout_width="116dp"
                        android:layout_height="116dp" />

                    <TextView
                        android:id="@+id/btnR3"
                        style="@style/PadSmall"
                        android:text="R3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Kanan: R1/R2 + tombol aksi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnR1"
                    style="@style/PadShoulder"
                    android:text="R1" />

                <TextView
                    android:id="@+id/btnR2"
                    style="@style/PadShoulder"
                    android:text="R2" />
            </LinearLayout>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3"
                android:rowCount="3">

                <TextView
                    android:id="@+id/btnTriangle"
                    style="@style/PadRound"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:text="△"
                    android:textColor="#3DDC97" />

                <TextView
                    android:id="@+id/btnSquare"
                    style="@style/PadRound"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:text="□"
                    android:textColor="#E87EC0" />

                <TextView
                    android:id="@+id/btnCircle"
                    style="@style/PadRound"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:text="○"
                    android:textColor="#FF5C5C" />

                <TextView
                    android:id="@+id/btnCross"
                    style="@style/PadRound"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:text="✕"
                    android:textColor="#5C9DFF" />
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
